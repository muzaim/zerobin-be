# App Config
APP_ENV=development
APP_PORT=8080
APP_NAME=cellar-backend
LOG_LEVEL=debug

# Database Config
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cellar
DB_SSLMODE=disable
AUTO_MIGRATE=true

# JWT Config
JWT_SECRET=super_secret_key_change_me_in_production_12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# CORS Config
CORS_ALLOWED_ORIGINS=*
