# App Config
APP_ENV=development
APP_PORT=8080
APP_NAME=zerobin-be
LOG_LEVEL=debug

# Database Config
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=zerobin
DB_SSLMODE=disable
AUTO_MIGRATE=true

# JWT Config
JWT_SECRET=super_secret_key_change_me_in_production_12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# CORS Config
CORS_ALLOWED_ORIGINS=*

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=zerobin-avatars
MINIO_PUBLIC_URL=http://localhost:9000/zerobin-avatars

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@zerobin.com
